# Зразок налаштувань. Скопіюйте файл як .env і задайте власний ключ адміністратора.
KINOGRAF_ADMIN_KEY=change_me
KINOGRAF_MIN_YEAR=1991
# Пауза в секундах перед повторним запитом до Wikidata (обмеження — 1 запит на хвилину)
KINOGRAF_RETRY_DELAY=60
# Базова адреса застосунку: від неї будуються постійні адреси сутностей (/id/film/...)
KINOGRAF_BASE_URL=http://localhost:8080
