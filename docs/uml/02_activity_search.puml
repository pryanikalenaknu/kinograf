@startuml
!include common.iuml
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #1F4E79
}
title Пошук і перегляд фільму
|Користувач|
start
:Відкрити каталог;
repeat
  |Користувач|
  :Ввести назву або обрати фільтри;
  |Застосунок|
  :Перевірити параметри запиту;
  :Виконати повнотекстовий пошук\nі фільтрацію в SQLite;
  backward:Показати повідомлення\n«Нічого не знайдено»;
repeat while (Знайдено фільми?) is (ні) not (так)
:Сформувати сторінку результатів\nз пагінацією;
|Користувач|
:Обрати фільм у списку;
|Застосунок|
fork
  :Отримати дані фільму\nй учасників за ролями;
fork again
  :Знайти пов'язані фільми\nза спільними учасниками;
end fork
:Показати картку фільму;
|Користувач|
if (Подальша дія?) then (персоналія)
  :Відкрити сторінку персоналії;
elseif (граф) then
  :Відкрити граф зв'язків фільму;
else (джерело)
  :Перейти до запису у Wikidata;
endif
stop
@enduml
