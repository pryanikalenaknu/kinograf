@startuml
!include common.iuml
skinparam activity {
  BackgroundColor #EAF2FB
  BorderColor #1F4E79
}
title Оновлення даних з Wikidata
|Адміністратор|
start
:Ввести ключ доступу;
:Запустити оновлення;
|Застосунок|
if (Ключ правильний?) then (ні)
  :Відмовити в доступі (401);
  stop
else (так)
endif
:Створити запис журналу\n(статус «виконується»);
repeat
  |Застосунок|
  :Сформувати SPARQL-запит\nчергової групи даних\n(фільми, учасники, жанри, нагороди,\nпосилання на інші набори);
  |Wikidata|
  :Виконати запит,\nповернути JSON;
  |Застосунок|
  if (Відповідь отримано\nза 3 спроби?) then (ні)
    :Записати в журнал\nстатус «помилка»;
    stop
  else (так)
    :Перетворити JSON\nна моделі предметної області;
  endif
repeat while (Є ще групи даних?) is (так) not (ні)
fork
  :Записати дані в SQLite\nв одній транзакції;
  :Перебудувати індекс\nповнотекстового пошуку;
fork again
  :Оновити локальний RDF-граф;
end fork
fork
  :Побудувати опублікований граф\nу словнику schema.org\nз посиланнями owl:sameAs;
  :Зберегти linked.ttl\nі опис набору VoID;
fork again
  :Перевірити локальний граф\nза правилами SHACL;
  :Записати зауваження\nі звіт перевірки;
end fork
:Записати в журнал статус «успішно»\nі кількість змінених записів;
|Адміністратор|
:Переглянути підсумок оновлення;
stop
@enduml
